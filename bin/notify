#!/usr/bin/env ruby
# frozen_string_literal: true

require "dotenv/load"
require_relative "../lib/three_r"

target_date = ThreeR.target_date
year = target_date.year
month = target_date.month

unless ThreeR::ScheduleStore.exists?(year, month)
  puts "Calendar for #{year}/#{month} not found. Fetching..."
  area_id = ThreeR::Config.area_id
  entries = ThreeR::CalendarParser.fetch(area_id:, year:, month:)

  case entries
  in []
    warn "Warning: no garbage collection data found for #{year}/#{month}"
    exit 1
  in [*, _]
    ThreeR::ScheduleStore.save(year, month, entries)
    puts "Saved #{entries.size} entries."
  end
end

entries = ThreeR::ScheduleStore.load(year, month)

case entries&.find { _1.date == target_date }
in nil
  puts "No garbage collection on #{target_date}."
in ThreeR::ScheduleEntry => entry
  puts "Target (#{entry.date_key}): #{entry.kinds.join(", ")}"
  ThreeR::Notifier.configure!
  ThreeR::Notifier.send_notification(entry)
  puts "Notification sent!"
end
